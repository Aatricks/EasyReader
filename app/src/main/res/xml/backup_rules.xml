<?xml version="1.0" encoding="utf-8"?>
<!--
    Legacy auto-backup rules for API <= 30. minSdk is 30 so this rarely applies,
    but the file is kept so AGP does not warn. Match data_extraction_rules.xml:
    no cloud auto-backup, all data stays device-local. Explicitly exclude files
    too: persistent chapter downloads live under filesDir/downloads, and stale
    image files must not be resurrected by an uninstall/reinstall restore.

    See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
